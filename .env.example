# ==============================================================================
# HYDROWELL — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env with real credentials to GitHub.
# ==============================================================================

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=borewell_db
DB_USER=root
DB_PASSWORD=

# App Configuration
APP_ENV=development
APP_NAME=HYDROWELL
APP_URL=http://localhost

# WhatsApp Dispatch Configuration
# Target Numbers:
# Number 1: 919880701789 (Existing company WhatsApp number)
# Number 2: 919380410134 (Required secondary WhatsApp number)
WHATSAPP_RECIPIENT_1=919880701789
WHATSAPP_RECIPIENT_2=919380410134

# Meta / WhatsApp Cloud Business API (Optional for automated background dispatch)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
